{
  "name": "typescript-express-app",
  "version": "1.0.0",
  "description": "A simple TypeScript Express application",
  "main": "src/app.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node -r module-alias/register dist/app.js",
    "postinstall": "npm run build"
  },
  "_moduleAliases": {
    "src": "./dist"
  },
  "dependencies": {
    "@types/mongodb": "^4.0.6",
    "cloudinary": "^2.7.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "module-alias": "^2.3.4",
    "mongodb": "^6.15.0",
    "mongoose": "^8.16.3",
    "multer": "^2.0.1",
    "nodemon": "^3.1.10",
    "sharp": "^0.34.2",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/sharp": "^0.31.1",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
